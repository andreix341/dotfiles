{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg": "#000000",
    "bgSelect": "#3A2A4D",
    "bgDim": "#000000",
    "fg": "#EEEEEE",
    "white": "#FFFFFF",
    "purple": "#C9A0DC",
    "purpleSoft": "#C6A0F6",
    "lavender": "#D3D3FF",
    "teal": "#98C379",
    "green": "#5FB878",
    "red": "#F06C6C",
    "orange": "#E2A76F",
    "pink": "#F280B0",
    "cyan": "#8FB9D8",
    "gray": "#A5A5A5",
    "bracket": "#C8C8C8",
    "dim": "#6D6964",
    "outline": "#3C3C3C",
    "redDim": "#A05A5A",
    "orangeDim": "#9A7A52",
    "cyanDim": "#6E8CA0",
    "lavenderDim": "#7E82A0",
    "greenDim": "#5A8C70"
  },
  "theme": {
    "primary": { "dark": "purple", "light": "purple" },
    "secondary": { "dark": "purpleSoft", "light": "purpleSoft" },
    "accent": { "dark": "lavender", "light": "lavender" },
    "error": { "dark": "red", "light": "red" },
    "warning": { "dark": "orange", "light": "orange" },
    "success": { "dark": "green", "light": "green" },
    "info": { "dark": "cyan", "light": "cyan" },

    "text": { "dark": "fg", "light": "fg" },
    "textMuted": { "dark": "gray", "light": "gray" },

    "background": { "dark": "bg", "light": "bg" },
    "backgroundPanel": { "dark": "bg", "light": "bg" },
    "backgroundElement": { "dark": "bg", "light": "bg" },
    "border": { "dark": "outline", "light": "outline" },
    "borderActive": { "dark": "purple", "light": "purple" },
    "borderSubtle": { "dark": "bg", "light": "bg" },

    "diffAdded": { "dark": "green", "light": "green" },
    "diffRemoved": { "dark": "red", "light": "red" },
    "diffContext": { "dark": "gray", "light": "gray" },
    "diffHunkHeader": { "dark": "lavender", "light": "lavender" },
    "diffHighlightAdded": { "dark": "teal", "light": "teal" },
    "diffHighlightRemoved": { "dark": "pink", "light": "pink" },
    "diffAddedBg": { "dark": "bg", "light": "bg" },
    "diffRemovedBg": { "dark": "bg", "light": "bg" },
    "diffContextBg": { "dark": "bg", "light": "bg" },
    "diffLineNumber": { "dark": "bracket", "light": "bracket" },
    "diffAddedLineNumberBg": { "dark": "bg", "light": "bg" },
    "diffRemovedLineNumberBg": { "dark": "bg", "light": "bg" },

    "markdownText": { "dark": "fg", "light": "fg" },
    "markdownHeading": { "dark": "purple", "light": "purple" },
    "markdownLink": { "dark": "cyan", "light": "cyan" },
    "markdownLinkText": { "dark": "lavender", "light": "lavender" },
    "markdownCode": { "dark": "teal", "light": "teal" },
    "markdownBlockQuote": { "dark": "dim", "light": "dim" },
    "markdownEmph": { "dark": "pink", "light": "pink" },
    "markdownStrong": { "dark": "white", "light": "white" },
    "markdownHorizontalRule": { "dark": "dim", "light": "dim" },
    "markdownListItem": { "dark": "fg", "light": "fg" },
    "markdownListEnumeration": { "dark": "lavender", "light": "lavender" },
    "markdownImage": { "dark": "cyan", "light": "cyan" },
    "markdownImageText": { "dark": "lavender", "light": "lavender" },
    "markdownCodeBlock": { "dark": "bracket", "light": "bracket" },

    "syntaxComment": { "dark": "dim", "light": "dim" },
    "syntaxKeyword": { "dark": "purple", "light": "purple" },
    "syntaxFunction": { "dark": "cyan", "light": "cyan" },
    "syntaxVariable": { "dark": "pink", "light": "pink" },
    "syntaxString": { "dark": "green", "light": "green" },
    "syntaxNumber": { "dark": "orange", "light": "orange" },
    "syntaxType": { "dark": "teal", "light": "teal" },
    "syntaxOperator": { "dark": "lavender", "light": "lavender" },
    "syntaxPunctuation": { "dark": "bracket", "light": "bracket" }
  }
}